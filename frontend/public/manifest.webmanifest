{
  "name": "CondenseIt",
  "short_name": "CondenseIt",
  "description": "AI-powered news digest pipeline",
  "start_url": "/",
  "display": "standalone",
  "theme_color": "#0d9488",
  "background_color": "#f8fafc",
  "icons": [
    {
      "src": "/icon.svg",
      "type": "image/svg+xml",
      "sizes": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/icons/icon-512.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ]
}

# CondenseIt environment configuration
# Copy to .env and fill in your values.
# Never commit .env - it contains secrets.

# ---------------------------------------------------------------------------
# LOCAL MODE (Ollama on your Mac or server)
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ---------------------------------------------------------------------------
# REMOTE MODE (OpenRouter in the cloud - default provider)
# ---------------------------------------------------------------------------
# Required by default (llm.provider defaults to "openrouter").
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Built-in scheduler
# Set to 1 to run digests automatically at the times configured in the admin.
# Recommended for remote VPS deployments (replaces cron/launchd).
# ---------------------------------------------------------------------------
CONDENSEIT_SCHEDULER_ENABLED=0

# ---------------------------------------------------------------------------
# Auth (recommended for any internet-facing deployment)
# Leave both empty to disable login (anyone with the URL can access).
# ---------------------------------------------------------------------------
# Password for the login screen on the web UI.
CONDENSEIT_AUTH_PASSWORD=
# Legacy alias kept for older deployments.
DIGEST_PWA_AUTH_PASSWORD=
# Fixed session secret - prevents log-out on service restart.
# Generate: openssl rand -hex 32
DIGEST_PWA_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Paths (optional overrides)
# ---------------------------------------------------------------------------
CONDENSEIT_CONFIG=config.yaml
CONDENSEIT_DATA_DIR=data
# Set to frontend/dist path when running in Docker or non-repo layout.
CONDENSEIT_FRONTEND_DIST=

# ---------------------------------------------------------------------------
# Remote sync (pull ratings and read state before each local digest run)
# ---------------------------------------------------------------------------
# Example: CONDENSEIT_RATINGS_IMPORT_URL=https://digest.example.com/api/ratings/export
CONDENSEIT_RATINGS_IMPORT_PATH=
CONDENSEIT_RATINGS_IMPORT_URL=
# Bearer tokens for authenticated endpoints (never commit).
CONDENSEIT_RATINGS_IMPORT_BEARER_TOKEN=
CONDENSEIT_READ_IMPORT_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Digest limits (optional overrides for YAML config)
# ---------------------------------------------------------------------------
CONDENSEIT_MAX_ARTICLES_PER_DIGEST=
CONDENSEIT_USER_AGENT=

# ---------------------------------------------------------------------------
# VPS deployment (used by scripts/deploy.sh)
# ---------------------------------------------------------------------------
DIGEST_PWA_SSH_HOST=
DIGEST_PWA_DOMAIN=
DIGEST_PWA_REMOTE_DIR=/var/www/digest.example.com
DIGEST_PWA_LIVE_URL=
CONDENSEIT_VPS_PORT=8765
CONDENSEIT_VPS_DATA_DIR=

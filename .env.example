# Native Ollama on the host (not used by the Docker UI container)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional: email when a digest run finishes (Resend)
RESEND_API_KEY=
# Sender and recipient (override email.from / email.to from config.yaml)
RESEND_FROM=CondenseIt <digest@example.com>
DIGEST_EMAIL_TO=you@example.com

# Paths (optional overrides)
CONDENSEIT_CONFIG=config.yaml
CONDENSEIT_DATA_DIR=data
# Vite SPA for / and /admin (Docker sets this to /app/frontend/dist in compose)
CONDENSEIT_FRONTEND_DIST=

# Optional: merge ratings before each ``condenseit run`` (file, then URL).
# Use ``condenseit ratings-import`` for one-off imports.
CONDENSEIT_RATINGS_IMPORT_PATH=
# Point at the condenseit-web service on your VPS to pull server-side ratings
# automatically before every local digest run (see bootstrap-ratings-service.sh).
# Example: CONDENSEIT_RATINGS_IMPORT_URL=https://digest.example.com/api/ratings/export
CONDENSEIT_RATINGS_IMPORT_URL=
# Optional: bearer token for CONDENSEIT_RATINGS_IMPORT_URL only (never commit).
CONDENSEIT_RATINGS_IMPORT_BEARER_TOKEN=

# Optional: cap digest items (overrides YAML max_articles_per_digest)
CONDENSEIT_MAX_ARTICLES_PER_DIGEST=

# Optional: User-Agent for RSS / article / watch URL HTTP fetches (empty = Chrome-like default)
CONDENSEIT_USER_AGENT=

# Optional: VPS rsync after each digest run (same vars as scripts/deploy-digest-pwa.sh)
DIGEST_PWA_SSH_HOST=
DIGEST_PWA_REMOTE_DIR=/var/www/condenseit/
DIGEST_PWA_LIVE_URL=

# Server-side ratings on VPS (see scripts/bootstrap-ratings-service.sh).
# Set to 1 to enable SQLite DB sync and condenseit-web service management
# during deploy-digest-pwa.sh runs.
CONDENSEIT_VPS_WITH_SERVICE=0
# Port the condenseit-web FastAPI service listens on (default: 8765).
CONDENSEIT_VPS_PORT=8765
# Data directory on the VPS where condenseit.db lives (default: ~/condenseit/data).
CONDENSEIT_VPS_DATA_DIR=
